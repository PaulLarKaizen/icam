# Public site origin used to build a fixed OAuth callback URL.
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Browser-safe Supabase connection settings. The publishable key is safe for browser use with RLS enabled.
NUXT_PUBLIC_SUPABASE_URL=https://ghsdtjsfdurzdxgnlerm.supabase.co
NUXT_PUBLIC_SUPABASE_KEY=your-supabase-publishable-key

# Server-only Supabase secret key. Used only by the Google callback to write trusted identity app_metadata.
# NEVER prefix this key with NUXT_PUBLIC_ or commit a real value.
NUXT_SUPABASE_SECRET_KEY=

# GCO-style server-side Google authorization-code flow.
NUXT_GOOGLE_CLIENT_ID=
NUXT_GOOGLE_CLIENT_SECRET=
NUXT_GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Random secret of at least 32 characters for signing the short-lived OAuth state cookie.
NUXT_AUTH_STATE_SECRET=
