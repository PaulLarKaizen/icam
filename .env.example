# Nuxt public application URL
NUXT_PUBLIC_SITE_URL=http://localhost:3000

# Supabase project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase browser-safe public key
SUPABASE_KEY=your-browser-safe-public-key

# Server-only Supabase service-role key
# Do not expose this value to client code or commit it to source control.
SUPABASE_SERVICE_KEY=replace-with-server-only-secret

# Institutional Google OAuth
# Configure the provider and redirect URLs in Supabase and Google Cloud.
NUXT_PUBLIC_AUTH_PROVIDER=google
